APP_NAME=Drema
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.SEU_DOMINIO.com.br

# Domínio real do frontend, sem trailing slash
FRONTEND_URL=https://app.SEU_DOMINIO.com.br
CORS_ALLOWED_ORIGINS=https://app.SEU_DOMINIO.com.br
# Sem protocolo, sem porta (só host) — exigido pelo Sanctum SPA auth
SANCTUM_STATEFUL_DOMAINS=app.SEU_DOMINIO.com.br
SESSION_DOMAIN=.SEU_DOMINIO.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=drema
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# true em produção: cookie de sessão só trafega sobre HTTPS
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# log = nenhum e-mail é enviado de fato. Trocar por smtp/ses/postmark
# quando o produto passar a depender de e-mail (verificação, reset de senha).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contato@SEU_DOMINIO.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
